        .caught_by = .{ .step = "test-tools" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC29",
        .what = "the reverse walk keeps no failure of its lookup, and a negative end or a cancel ends on zeros",
        .edits = .{
            .{ .file = "src/resolver/name_lookup.zig", .old = "    // Kept before the cancel is read, so a cancel after a failure ends on its fields.\n    self.last_failure = failure;\n", .new = "" },
