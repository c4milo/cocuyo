        .what = "a walk ends a hard failure with its error alone, on the fields of the last lookup that failed",
        .edits = .{
            .{ .file = "src/resolver/address_lookup_walk.zig", .old = "    if (hard_failure(self)) |failure| return end_failed_with(self, failure);", .new = "    if (hard_failure(self)) |failure| return end_failed(self, failure.err);" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC17",
        .what = "the reverse walk ends a hard failure with its error alone, on zeros and no cause",
        .edits = .{
            .{ .file = "src/resolver/name_lookup.zig", .old = "    if (!negative) return end_failed_with(self, failure);", .new = "    if (!negative) return end_failed_with(self, .{ .err = failure.err, .server_index = 0, .attempts_made = 0, .negative_ttl_seconds = 0, .cause = null });" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
