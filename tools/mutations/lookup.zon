// The mutations of the state machine of design §5, its transports, and the answers it hands
// a cache and is handed back: each breaks the code one way, and must be caught by the check
// `caught_by` names (docs/mutations.md).
// tools/mutations.zig runs them. An edit replaces `old`, which must occur once, with `new`.
.{
    .{
        .section = "Step 3, the state machine",
        .id = "S1",
        .what = "the transaction id is not checked",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    if (header.id != self.transaction.id) return null;", .new = "    if (false and header.id != self.transaction.id) return null;" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "Step 3, the state machine",
        .id = "S2",
        .what = "the source address is not checked",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    if (!server.equal(&from)) return null;", .new = "    if (server.port != from.port) return null;" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "Step 3, the state machine",
        .id = "S3",
        .what = "the source port is not compared",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    if (!server.equal(&from)) return null;", .new = "    if (!server.address.equal(&from.address)) return null;" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "Step 3, the state machine",
        .id = "S4",
        .what = "the question section is not compared",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    if (!wire.question.matches(message, cased, self.question.kind)) return null;", .new = "    if (false and !wire.question.matches(message, cased, self.question.kind)) return null;" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "Step 3, the state machine",
        .id = "S5",
        .what = "the qname goes out uncased",
        .edits = .{
            .{ .file = "src/resolver/lookup.zig", .old = "        if (self.flags.mix_case) wire.name.mix_case(&name, self.transaction.case_seed);", .new = "        if (false and self.flags.mix_case) wire.name.mix_case(&name, self.transaction.case_seed);" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "Step 3, the state machine",
        .id = "S6",
        .what = "a response is read whatever the state",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    if (self.state != .awaiting_udp and self.state != .awaiting_tcp) return null;", .new = "    if (false and self.state != .awaiting_udp and self.state != .awaiting_tcp) return null;" },
            .{ .file = "src/resolver/lookup_response.zig", .old = "    assert(!self.is_settled());\n    return apply(self, message, accepted, &cased, now_ns);", .new = "    return apply(self, message, accepted, &cased, now_ns);" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "Step 3, the state machine",
        .id = "S7",
        .what = "truncation over TCP is obeyed",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    if (header.truncated() and !over_stream(self) and !self.config.ignore_truncation) {", .new = "    if (header.truncated() and !self.config.sends_requests() and !self.config.ignore_truncation) {" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "Step 3, the state machine",
        .id = "S8",
        .what = "a malformed answer fails the lookup",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "            return .accepted;\n        }\n        return .ignored;\n    };", .new = "            return .accepted;\n        }\n        self.fail(core.Error.MalformedMessage);\n        return .accepted;\n    };" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "Step 3, the state machine",
        .id = "S9",
