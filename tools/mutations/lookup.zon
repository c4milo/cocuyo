        .what = "the reverse walk reads the cancel before it keeps the failure of its lookup",
        .edits = .{
            .{ .file = "src/resolver/name_lookup.zig", .old = "    // Kept before the cancel is read, so a cancel after a failure ends on its fields.\n    self.last_failure = failure;\n    if (self.cancelled) return end_failed(self, core.Error.Canceled);\n", .new = "    if (self.cancelled) return end_failed(self, core.Error.Canceled);\n    self.last_failure = failure;\n" },
        },
