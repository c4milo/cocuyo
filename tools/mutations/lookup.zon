        .section = "DoQ's DNS half",
        .id = "QU6",
        .what = "a DoQ query carries the server's cookie",
        .edits = .{
            .{ .file = "src/resolver/lookup.zig", .old = "return self.flags.edns_enabled and !self.config.sends_requests();", .new = "return self.flags.edns_enabled and !self.config.uses_https();" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "DoQ's DNS half",
        .id = "QU7",
        .what = "TC=1 over DoQ sends the lookup to TCP",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    return self.state == .awaiting_tcp or self.config.sends_requests();", .new = "    return self.state == .awaiting_tcp or self.config.uses_https();" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "DoQ's DNS half",
        .id = "QU8",
        .what = "a datagram answers a lookup over DoQ",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    if (self.config.sends_requests()) return null;", .new = "    if (self.config.uses_https()) return null;" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "DoQ's DNS half",
        .id = "QU9",
        .what = "a lookup over DoQ asks for a datagram",
        .edits = .{
            .{ .file = "src/resolver/lookup_poll.zig", .old = ".query_ready => if (self.config.sends_requests()) send_request(self, out) else send_udp(self, out),", .new = ".query_ready => if (self.config.uses_https()) send_request(self, out) else send_udp(self, out)," },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "An answer's TTL",
        .id = "TT1",
        .what = "zero reads as \"nothing noted\", as before the fix",
        .edits = .{
            .{ .file = "src/wire/response.zig", .old = "    out.ttl_seconds = @min(out.ttl_seconds, ttl_seconds);", .new = "    if (out.ttl_seconds == 0 or ttl_seconds < out.ttl_seconds) out.ttl_seconds = ttl_seconds;" },
        },
        .caught_by = .{ .step = "test-wire" },
    },
    .{
        .section = "An answer's TTL",
        .id = "TT2",
        .what = "an empty collection's smallest TTL is zero",
        .edits = .{
            .{ .file = "src/wire/response.zig", .old = "const ttl_none = std.math.maxInt(u32);", .new = "const ttl_none = 0;" },
        },
        .caught_by = .{ .step = "test-wire" },
    },
    .{
        .section = "An answer's TTL",
        .id = "TT3",
        .what = "a negative's TTL ignores the CNAMEs in its own message",
        .edits = .{
            .{ .file = "src/wire/response.zig", .old = "if (record.is_kind(.soa)) return @min(try record.soa_negative_ttl(message), chain_ttl_seconds);", .new = "if (record.is_kind(.soa)) return try record.soa_negative_ttl(message);" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "An answer's TTL",
        .id = "TT4",
        .what = "nothing is bounded by the chain earlier messages moved",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    if (self.cname_hops == 0) return ttl_seconds;\n    return @min(ttl_seconds, self.chain_ttl_seconds);", .new = "    if (true) return ttl_seconds;\n    return @min(ttl_seconds, self.chain_ttl_seconds);" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "An answer's TTL",
        .id = "TT5",
        .what = "an answer is not bounded by the chain",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "            assert(self.answers.count > 0);\n            self.answers.ttl_seconds = bounded_by_chain(self, self.answers.ttl_seconds);\n", .new = "            assert(self.answers.count > 0);\n" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "An answer's TTL",
        .id = "TT6",
        .what = "a second alias forgets the first one's TTL",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "            self.chain_ttl_seconds = bounded_by_chain(self, self.answers.ttl_seconds);", .new = "            self.chain_ttl_seconds = self.answers.ttl_seconds;" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "An answer's TTL",
        .id = "TT7",
        .what = "a DoH answer loses its `Age` after the chain bounds it",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    self.answers.age(self.question.kind, accepted.age_seconds);\n    switch (outcome) {\n        .answered => {\n            assert(self.answers.count > 0);\n            self.answers.ttl_seconds = bounded_by_chain(self, self.answers.ttl_seconds);\n", .new = "    if (outcome != .answered) self.answers.age(self.question.kind, accepted.age_seconds);\n    switch (outcome) {\n        .answered => {\n            assert(self.answers.count > 0);\n            self.answers.ttl_seconds = bounded_by_chain(self, self.answers.ttl_seconds);\n            self.answers.age(self.question.kind, accepted.age_seconds);\n" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "An answer's TTL",
        .id = "TT8",
        .what = "a negative's TTL is not bounded by the chain",
        .edits = .{
            .{ .file = "src/resolver/lookup_response.zig", .old = "    const carried = wire.response.negative_ttl_seconds(message, cased) catch 0;\n    return bounded_by_chain(self, carried -| age_seconds);", .new = "    _ = self;\n    const carried = wire.response.negative_ttl_seconds(message, cased) catch 0;\n    return carried -| age_seconds;" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "A refusal is a failure",
        .id = "RF3",
        .what = "a failed connection is counted as silence",
        .edits = .{
            .{ .file = "src/resolver/lookup.zig", .old = "        self.servers.record_failure(self.server_slot(), now_ns);\n        self.flags.had_server_failure = true;\n        self.next_server(now_ns);\n    }\n\n    /// Gives up", .new = "        self.servers.record_failure(self.server_slot(), now_ns);\n        self.next_server(now_ns);\n    }\n\n    /// Gives up" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
    .{
        .section = "A refusal is a failure",
        .id = "RF4",
        .what = "a failed request is counted as silence",
        .edits = .{
            .{ .file = "src/resolver/lookup_request.zig", .old = "    self.servers.record_failure(self.server_slot(), now_ns);\n    self.flags.had_server_failure = true;\n", .new = "    self.servers.record_failure(self.server_slot(), now_ns);\n" },
        },
        .caught_by = .{ .step = "test-resolver" },
    },
}
