// The mutations of the Lean model of design §5 and its proofs: each breaks the model one way,
// and must be caught by `zig build spec-lean`, its proofs or its replay (docs/mutations.md).
// tools/mutations.zig runs them. An edit replaces `old`, which must occur once, with `new`.
.{
    .{
        .section = "The Lean model and the replay",
        .id = "M1",
        .what = "the model keeps EDNS0 off at the next server",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    { s with server := s.server + 1, stage := fresh c, edns := true, cookieRetried := false,\n", .new = "    { s with server := s.server + 1, stage := fresh c, cookieRetried := false,\n" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The Lean model and the replay",
        .id = "M2",
        .what = "the model ignores TC=1 over a stream",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if stream then (nextCandidate c s true, .accepted)\n    else ({ s with stage := .tcpNeeded }, .accepted)", .new = "    if stream then (s, .ignored)\n    else ({ s with stage := .tcpNeeded }, .accepted)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The Lean model and the replay",
        .id = "P1",
        .what = "sent_lt proved by sorry",
        .edits = .{
            .{ .file = "spec/lean/Spec/LookupProofs/Measure.lean", .old = "    LexLt (measure c (step c s .sent).1) (measure c s) := by\n  rcases h with h | h <;> simp [step, measure, LexLt, phase, stagePhase, h]", .new = "    LexLt (measure c (step c s .sent).1) (measure c s) := by\n  sorry" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "DoH's DNS half",
        .id = "DM1",
        .what = "a reply over DoH is read as a datagram's",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "  | .awaitingUdp => onReply c s c.request r", .new = "  | .awaitingUdp => onReply c s false r" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "DoH's DNS half",
        .id = "DM2",
        .what = "a poll over DoH asks for a datagram",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "if c.request then .sendRequest else .sendUdp)", .new = "if false then .sendRequest else .sendUdp)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "DoH's DNS half",
        .id = "DM3",
        .what = "an HTTP failure changes nothing",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if c.request ∧ s.stage = .awaitingUdp then (advanceServer c (keep s (.reason r)), .none)\n    else (s, .none)", .new = "    if c.request ∧ s.stage = .awaitingUdp then (s, .none)\n    else (s, .none)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },

    .{
        .section = "A refusal is a failure",
        .id = "RF1",
        .what = "the model counts a failed connection as silence",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if onStream s.stage then (advanceServer c (keep s (.reason r)), .none)\n", .new = "    if onStream s.stage then (advanceServer c s, .none)\n" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },

    .{
        .section = "A refusal is a failure",
        .id = "RF2",
        .what = "the model counts a failed request as silence",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if c.request ∧ s.stage = .awaitingUdp then (advanceServer c (keep s (.reason r)), .none)\n    else (s, .none)", .new = "    if c.request ∧ s.stage = .awaitingUdp then (advanceServer c s, .none)\n    else (s, .none)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },

    .{
        .section = "A fresh client cookie until a server cookie pairs with it",
        .id = "CO22",
        .what = "the model advances the server at a first BADCOOKIE over a stream, as before #36",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "      if c.request || s.cookieRetried then (advanceServer c (keep s .badcookie), .accepted)", .new = "      if c.request || s.cookieRetried || stream then (advanceServer c (keep s .badcookie), .accepted)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A fresh client cookie until a server cookie pairs with it",
        .id = "CO23",
        .what = "the model retries a BADCOOKIE over DoH or DoQ on a stream",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "      if c.request || s.cookieRetried then (advanceServer c (keep s .badcookie), .accepted)", .new = "      if s.cookieRetried then (advanceServer c (keep s .badcookie), .accepted)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A fresh client cookie until a server cookie pairs with it",
        .id = "CO24",
        .what = "the model's retry over a stream does not spend the server's retry",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "      else ({ s with cookieRetried := true, stage := .tcpNeeded }, .accepted)", .new = "      else ({ s with stage := .tcpNeeded }, .accepted)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC22",
        .what = "the model keeps the cause FORMERR at SERVFAIL",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "  | .servfail => (advanceServer c (keep s .servfail), .accepted)", .new = "  | .servfail => (advanceServer c (keep s .formerr), .accepted)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC23",
        .what = "the model's failed stream keeps the connect's reason, whatever reason it came with",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if onStream s.stage then (advanceServer c (keep s (.reason r)), .none)\n", .new = "    if onStream s.stage then (advanceServer c (keep s (.reason .connect)), .none)\n" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },

    .{
        .section = "The cause of a failure",
        .id = "LC24",
        .what = "the model's failed request keeps the closed connection's reason, whatever reason it came with",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    if c.request ∧ s.stage = .awaitingUdp then (advanceServer c (keep s (.reason r)), .none)\n    else (s, .none)", .new = "    if c.request ∧ s.stage = .awaitingUdp then (advanceServer c (keep s (.reason .closed)), .none)\n    else (s, .none)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },

    .{
        .section = "The cause of a failure",
        .id = "LC25",
        .what = "the model keeps the first cause, and a later server failure does not replace it",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "def keep (s : State) (w : What) : State := { s with cause := some { server := s.server, what := w } }", .new = "def keep (s : State) (w : What) : State := { s with cause := s.cause <|> some { server := s.server, what := w } }" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },

    .{
        .section = "The cause of a failure",
        .id = "LC26",
        .what = "the model forgets the cause at the end of its last pass",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    fail { s with round := s.round + 1 } (if s.cause.isSome then .allServersFailed else .timeout)", .new = "    fail { s with round := s.round + 1, cause := none } (if s.cause.isSome then .allServersFailed else .timeout)" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC27",
        .what = "the model's walk writes no cause",
        .edits = .{
            .{ .file = "spec/lean/Main.lean", .old = "    out.putStrLn s!\"{depth + 1} {eventToken e} {outToken o} {lineToken t}\"", .new = "    out.putStrLn s!\"{depth + 1} {eventToken e} {outToken o} {stateToken t}\"" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The cause of a failure",
        .id = "LC28",
        .what = "failure_cause proved by sorry",
        .edits = .{
            .{ .file = "spec/lean/Spec/LookupProofs/Cause.lean", .old = "  exact key es _ ⟨init_fits c, init_server c⟩", .new = "  sorry" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },

    .{
        .section = "A cause with its server and its reason",
        .id = "RS90",
        .what = "the model's cause names the first server, whichever server gave it",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "def keep (s : State) (w : What) : State := { s with cause := some { server := s.server, what := w } }", .new = "def keep (s : State) (w : What) : State := { s with cause := some { server := 0, what := w } }" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A cause with its server and its reason",
        .id = "RS91",
        .what = "the model's stream takes local after it is up",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "  if s = .connectingTcp then [.connect, .«local»] else [.closed]", .new = "  if s = .connectingTcp then [.connect, .«local»] else [.closed, .«local»]" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A cause with its server and its reason",
        .id = "RS92",
        .what = "the model's request over DoQ takes an HTTP status",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "  if c.quic then [.handshake, .«local», .closed, .reset]", .new = "  if c.quic then [.handshake, .«local», .closed, .status, .reset]" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A cause with its server and its reason",
        .id = "RS93",
        .what = "the model's request over DoH takes no connect",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "  else [.connect, .handshake, .«local», .closed, .status, .reset]", .new = "  else [.handshake, .«local», .closed, .status, .reset]" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A cause with its server and its reason",
        .id = "RS94",
        .what = "the transcript writes a cause without its server",
        .edits = .{
            .{ .file = "spec/lean/Spec/Tokens.lean", .old = "  | some k => s!\"{whatToken k.what}@{k.server}\"", .new = "  | some k => whatToken k.what" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A cause with its server and its reason",
        .id = "RS95",
        .what = "the transcript writes a failed connection without its reason",
        .edits = .{
            .{ .file = "spec/lean/Spec/Tokens.lean", .old = "  | .tcpConnected => \"tcp_connected\" | .tcpFailed r => \"tcp_failed_\" ++ reasonToken r", .new = "  | .tcpConnected => \"tcp_connected\" | .tcpFailed _ => \"tcp_failed\"" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "A cause with its server and its reason",
        .id = "RS96",
        .what = "the proof that a cause names a server of the configuration rests on sorry",
        .edits = .{
            .{ .file = "spec/lean/Spec/LookupProofs/Cause.lean", .old = "  | poll => exact poll_server c s h\n", .new = "  | poll => sorry\n" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The deadline of a ready lookup",
        .id = "RD9",
        .what = "the model's waiting leaves out tcpReady, as until 2026-10-24",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "  | .awaitingUdp | .connectingTcp | .tcpReady | .awaitingTcp => true\n", .new = "  | .awaitingUdp | .connectingTcp | .awaitingTcp => true\n" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The deadline of a ready lookup",
        .id = "RD10",
        .what = "the proof that a deadline ends tcpReady rests on sorry",
        .edits = .{
            .{ .file = "spec/lean/Spec/LookupProofs.lean", .old = "  refine ⟨by simp [enabled, h, waiting], ?_⟩\n  simp only [step, h, waiting, if_true]\n  rcases advanceServer_stage c s with hs | hs\n  · unfold fresh at hs\n    split at hs <;> simp [poll, hs]\n  · simp [poll, hs]\n", .new = "  sorry\n" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The deadline of a ready lookup",
        .id = "RD11",
        .what = "the model offers each reply in tcpReady, where only the unmatched reply comes",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "    ++ (if listens s.stage then replies else [Event.reply .unmatched])", .new = "    ++ (if waiting s.stage then replies else [Event.reply .unmatched])" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
    .{
        .section = "The deadline of a ready lookup",
        .id = "RD12",
        .what = "the model's deadline in tcpReady leaves the lookup in tcpReady",
        .edits = .{
            .{ .file = "spec/lean/Spec/Lookup.lean", .old = "  | .expire => if waiting s.stage then poll c (advanceServer c s) else poll c s", .new = "  | .expire => if waiting s.stage ∧ s.stage ≠ .tcpReady then poll c (advanceServer c s) else poll c s" },
        },
        .caught_by = .{ .step = "spec-lean" },
    },
}
