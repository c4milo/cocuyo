            .{ .file = "io/io_tcp_queue.zig", .old = "    if (connection.sending and head.slot == slot) return;\n", .new = "" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "One send a stream",
        .id = "SQ9",
        .what = "a send the loop refuses leaves the queue stuck",
        .edits = .{
            .{ .file = "io/io_tcp_queue.zig", .old = "    if (self.loop.submit(&.{operation}, &handles) != 1) return tcp.fail(self, at, tcp.reason_of(self, at, .local), now_ns);", .new = "    _ = now_ns;\n    if (self.loop.submit(&.{operation}, &handles) != 1) return;" },
        },
        .caught_by = .short_walks,
