    .{
        .section = "A connect's address",
        .id = "CR1",
        .what = "a closed slot is taken while its connect is in flight",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "        if (connection.state == .closed and !connection.borrowed()) return @intCast(at);", .new = "        if (connection.state == .closed) return @intCast(at);" },
            .{ .file = "io/io_tcp.zig", .old = "    assert(!connection.borrowed());\n", .new = "" },
