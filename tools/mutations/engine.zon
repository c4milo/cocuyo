    },
    .{
        .section = "A connect's address",
        .id = "CR2",
        .what = "a slot nobody uses is taken while its connect is in flight",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "        if (connection.users == 0 and !connection.borrowed()) {", .new = "        if (connection.users == 0) {" },
            .{ .file = "io/io_tcp.zig", .old = "    assert(!connection.borrowed());\n", .new = "" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "A connect's address",
        .id = "CR3",
        .what = "a connect's event leaves its slot marked",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "    assert(slot.connect_in_flight);\n    slot.connect_in_flight = false;", .new = "    assert(slot.connect_in_flight);" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "A connect's address",
        .id = "CR4",
        .what = "closing a slot forgets its connect is in flight",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "&.{ \"incarnation\", \"connect_in_flight\", \"records_send\",", .new = "&.{ \"incarnation\", \"records_send\"," },
