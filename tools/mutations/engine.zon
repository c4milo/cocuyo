// The engine's mutations: each breaks the engine of io/, or the table under it, one way, and must be
// caught by the check `caught_by` names (docs/mutations.md, the engine replay on TLC's walks).
// tools/mutations.zig runs them. An edit replaces `old`, which must occur once, with `new`.
.{
    .{
        .section = "The engine model and its replay",
        .id = "E1",
        .what = "an event for an opening that is gone is applied",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "    if (live and connection.incarnation == incarnation) return at;", .new = "    _ = incarnation;\n    if (live) return at;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine model and its replay",
        .id = "E2",
        .what = "a lookup stays on a connection it no longer streams to",
        .edits = .{
            .{ .file = "io/io_drive.zig", .old = "    tcp.follow(self, index, now_ns);\n", .new = "" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine model and its replay",
        .id = "E3",
        .what = "a new lookup forgets its slot's buffer is lent",
        .edits = .{
            .{ .file = "io/io.zig", .old = "            self.held[handle.index] = null;\n            self.reported[handle.index] = false;", .new = "            self.held[handle.index] = null;\n            self.send_in_flight[handle.index] = false;\n            self.reported[handle.index] = false;" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine model and its replay",
        .id = "E4",
        .what = "a send's completion speaks to whatever holds the slot",
        .edits = .{
            .{ .file = "io/io_send.zig", .old = "        if (went != null and is_current(self, index, made)) {\n            if (went.?) {\n                self.resolver.on_sent(made.handle, now_ns);\n            } else {\n                self.resolver.on_send_failed(made.handle, now_ns);\n            }\n        }", .new = "        _ = made;\n        const handle = self.handles[index];\n        if (went != null and self.slots[index].occupied and !self.resolver.lookup_of(handle).is_settled()) {\n            if (went.?) {\n                self.resolver.on_sent(handle, now_ns);\n            } else {\n                self.resolver.on_send_failed(handle, now_ns);\n            }\n        }" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine model and its replay",
        .id = "E5",
        .what = "a held send is dropped",
        .edits = .{
            .{ .file = "io/io_send.zig", .old = "    if (!is_current(self, index, held.owner)) return;\n    const bytes", .new = "    if (true) return;\n    const bytes" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine model and its replay",
        .id = "E6",
        .what = "the drive stops after one poll a slot",
        .edits = .{
            .{ .file = "io/io_drive.zig", .old = "    const polls_max = self.slots.len * limits.drive_polls_per_lookup_max;", .new = "    const polls_max = self.slots.len;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine model and its replay",
        .id = "E7",
        .what = "the table misses the deadline of a wait a poll starts",
        .edits = .{
            .{ .file = "src/resolver/table.zig", .old = "            if (slot.lookup.is_waiting()) ready_module.note_deadline(self, slot.lookup.deadline_ns);\n            if (action == .wait) continue;", .new = "            if (action == .wait) {\n                ready_module.note_deadline(self, action.wait);\n                continue;\n            }" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine model and its replay",
        .id = "E8",
        .what = "a stale event keeps its buffer",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "    if (event.flags.buffer) self.loop.give_back_buffer(constants.tcp_group_id, event.flags.buffer_id);\n    return null;", .new = "    _ = event;\n    return null;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET1",
        .what = "lookups hear the connection is up before the handshake",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "            receive_again(self, @intCast(at));\n            return tls_module.begin(self, @intCast(at), now_ns);", .new = "            receive_again(self, @intCast(at));\n            tls_module.begin(self, @intCast(at), now_ns);\n            return tell_all(self, @intCast(at), now_ns, null);" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET2",
        .what = "the session's records go to the back of the queue",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "    queue.insert_sealed(.{ .slot = ring.records, .end = end });", .new = "    queue.push(.{ .slot = ring.records, .end = end });" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET3",
        .what = "records made behind a waiting records entry take one of their own",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "    if (queue.sealed > 1 and !queue.at(queue.sealed - 1).is_query()) {", .new = "    if (false and queue.sealed > 1 and !queue.at(queue.sealed - 1).is_query()) {" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET4",
        .what = "a declined ticket fails the connection",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "        if (connection.tls.ticket != null) tcp.retry_full(self, at, now_ns) else refuse(self, at, .handshake, now_ns);", .new = "        if (connection.tls.ticket != null) tcp.fail(self, at, .handshake, now_ns) else refuse(self, at, .handshake, now_ns);" },
        },
        .caught_by = .picked_walks,
    },

    .{
        .section = "The engine over TLS",
        .id = "ET5",
        .what = "a spent ticket stays kept",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "    self.tls_tickets[server] = null;\n    if (!fresh(", .new = "    if (!fresh(" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET6",
        .what = "an idle TLS connection closes without close_notify",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "        if (connection.state == .up and tls_module.speaks(self)) {", .new = "        if (false and connection.state == .up and tls_module.speaks(self)) {" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET7",
        .what = "a TLS configuration opens UDP sockets",
        .edits = .{
            .{ .file = "io/io_udp.zig", .old = "        self.count = if (config.encrypted()) 0 else @intCast(config.servers.len);", .new = "        self.count = @intCast(config.servers.len);" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET8",
        .what = "a TLS connection is closed to make room",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "    if (tls_module.speaks(self)) return null;\n    for (self.connections[0..], 0..) |*connection, at| {", .new = "    for (self.connections[0..], 0..) |*connection, at| {" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET9",
        .what = "a records send's end leaves its slot borrowed",
        .edits = .{
            .{ .file = "io/io_tcp_queue.zig", .old = "    assert(borrower.records_send == ring.records);\n    borrower.records_send = null;", .new = "    assert(borrower.records_send == ring.records);" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET10",
        .what = "a reopening connection takes its old opening's events",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "    const live = connection.state != .closed and connection.state != .reopening;", .new = "    const live = connection.state != .closed;" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET11",
        .what = "a reopening connection connects while its old records are in flight",
        .edits = .{
            .{ .file = "io/io_tcp.zig", .old = "    if (connection.state != .reopening or connection.borrowed()) return;", .new = "    if (connection.state != .reopening or connection.connect_in_flight) return;" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET12",
        .what = "a record longer than 2^14 + 256 octets is waited for",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "    if (body > limits.tls_record_body_bytes_max) return error.Overflow;", .new = "    if (false and body > limits.tls_record_body_bytes_max) return error.Overflow;" },
        },
        .caught_by = .{ .step = "test-io" },
    },
    .{
        .section = "The engine over TLS",
        .id = "ET13",
        .what = "a ticket older than seven days is spent",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "    const lifetime_ns = @min(Session.lifetime_ns(&kept.ticket), limits.tls_ticket_age_ns_max);", .new = "    const lifetime_ns = Session.lifetime_ns(&kept.ticket);" },
        },
        .caught_by = .{ .step = "test-io" },
    },
    .{
        .section = "The engine over TLS",
        .id = "ET14",
        .what = "a closing connection reads what the peer sends",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "        .up => open(self, at, record, now_ns),", .new = "        .up => open(self, at, record, now_ns),\n        .closing => open(self, at, record, now_ns)," },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET15",
        .what = "a handshake the session refused closes its connection at once, its alert unsent",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "        if (connection.tls.ticket != null) tcp.retry_full(self, at, now_ns) else refuse(self, at, .handshake, now_ns);", .new = "        if (connection.tls.ticket != null) tcp.retry_full(self, at, now_ns) else tcp.fail(self, at, .handshake, now_ns);" },
        },
        .caught_by = .short_walks,
    },

    .{
        .section = "The engine over TLS",
        .id = "ET16",
        .what = "a refused handshake's connection reads on, and never closes once its alert has gone",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "    queue_module.drop_unsealed(self, at);\n    connection.state = .closing;\n", .new = "    queue_module.drop_unsealed(self, at);\n" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine over TLS",
        .id = "ET17",
        .what = "a record the session refuses once up closes the connection at once, its alert unsent",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "        // the session's alert said first (rule 4).\n        refuse(self, at, .closed, now_ns);", .new = "        // the session's alert said first (rule 4).\n        tcp.fail(self, at, .closed, now_ns);" },
        },
        .caught_by = .picked_walks,
    },

    .{
        .section = "The engine over TLS",
        .id = "ET18",
        .what = "a refusal leaves the queries not yet sealed queued behind the alert",
        .edits = .{
            .{ .file = "io/io_tls.zig", .old = "    tcp.abandon(self, at, reason, now_ns);\n    queue_module.drop_unsealed(self, at);\n", .new = "    tcp.abandon(self, at, reason, now_ns);\n" },
        },
        .caught_by = .picked_walks,
    },

    .{
        .section = "One send a stream",
        .id = "SQ1",
        .what = "the head goes out while a send is in flight",
        .edits = .{
            .{ .file = "io/io_tcp_queue.zig", .old = "    if (connection.sending) return;\n    const head = connection.queue.first() orelse return;", .new = "    const head = connection.queue.first() orelse return;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "One send a stream",
        .id = "SQ2",
        .what = "a short send is taken for a whole one",
        .edits = .{
            .{ .file = "io/io_tcp_queue.zig", .old = "    return count == left;", .new = "    return count > 0;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "One send a stream",
        .id = "SQ3",
        .what = "the rest is sent from the message's start",
        .edits = .{
            .{ .file = "io/io_tcp_queue.zig", .old = "    return self.send_buffers[head.slot][connection.sent_bytes..length];", .new = "    return self.send_buffers[head.slot][0 .. length - connection.sent_bytes];" },
        },
        .caught_by = .{ .step = "test-io" },
    },
    .{
        .section = "One send a stream",
        .id = "SQ4",
        .what = "the octets sent are counted from the last send alone",
        .edits = .{
            .{ .file = "io/io_tcp_queue.zig", .old = "    connection.sent_bytes += @intCast(count);", .new = "    connection.sent_bytes = @intCast(count);" },
        },
        .caught_by = .{ .step = "test-io" },
    },
    .{
        .section = "One send a stream",
        .id = "SQ5",
        .what = "a failed send leaves the connection up",
        .edits = .{
            .{ .file = "io/io_tcp_queue.zig", .old = "        send_module.give_back(self, slot);\n        return tcp.fail(self, at, .closed, now_ns);", .new = "        send_module.give_back(self, slot);\n        return after_send(self, at, now_ns);" },
        },
        .caught_by = .short_walks,
    },

    .{
        .section = "One send a stream",
        .id = "SQ6",
        .what = "a lookup that leaves keeps its waiting query queued",
        .edits = .{
            .{ .file = "io/io_tcp_queue.zig", .old = "    if (!connection.queue.contains(slot)) return;", .new = "    if (true) return;" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "One send a stream",
        .id = "SQ7",
        .what = "a closed connection keeps its waiting queries' buffers lent",
        .edits = .{
            .{ .file = "io/io_tcp_queue.zig", .old = "        if (connection.sending and position == 0) continue;\n        send_module.give_back(self, entry.slot);", .new = "        if (connection.sending and position == 0) continue;" },
        },
        .caught_by = .short_walks,
