            .{ .file = "io/io_request_connection.zig", .old = "        if (connection.receive == null) arm(self, server);\n", .new = "" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "Requests replayed on the model's walks",
        .id = "RW8",
        .what = "a connection closes for idleness with requests on it",
