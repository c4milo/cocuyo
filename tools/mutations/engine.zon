    .{
        .section = "One send a stream",
        .id = "SQ10",
        .what = "a whole send does not let the next go",
        .edits = .{
            .{ .file = "io/io_tcp_queue.zig", .old = "    send_module.finish(self, slot, true, now_ns);\n    after_send(self, at, now_ns);", .new = "    send_module.finish(self, slot, true, now_ns);" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "The engine's datagrams",
        .id = "U1",
        .what = "a receive a replaced socket left behind keeps its datagram's buffer",
        .edits = .{
            .{ .file = "io/io_events.zig", .old = "    const found = self.sockets.find(index) orelse {\n        if (event.flags.buffer) self.loop.give_back_buffer(constants.group_id, event.flags.buffer_id);\n        return;\n    };", .new = "    const found = self.sockets.find(index) orelse return;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine's datagrams",
        .id = "U2",
        .what = "a socket's receive the loop refused is never asked for again",
        .edits = .{
            .{ .file = "io/io_udp.zig", .old = "        if (!self.items[index].receiving) self.arm(loop, &self.items[index], index, tag) catch {};", .new = "        if (!self.items[index].receiving and self.items[index].armed_generation == 0) self.arm(loop, &self.items[index], index, tag) catch {};" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "The engine's datagrams",
        .id = "U6",
        .what = "a connection's receive the loop refused is never asked for again",
        .edits = .{
            .{ .file = "io/io_drive.zig", .old = "    tcp.tend(self);\n", .new = "" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "A port replaced under load",
        .id = "W1",
        .what = "a port that has carried its share is never replaced",
        .edits = .{
            .{ .file = "io/io_udp.zig", .old = "        return self.items[index].retiring and !self.draining[index].open;", .new = "        return self.items[index].retiring and !self.draining[index].open and index > constants.receive_index_mask;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "A port replaced under load",
        .id = "W2",
        .what = "a replaced socket is closed at once, and its answers are lost",
        .edits = .{
            .{ .file = "io/io_drive.zig", .old = "    const epoch = self.sockets.draining[server].epoch;\n", .new = "    if (server < 255) return false;\n    const epoch = self.sockets.draining[server].epoch;\n" },
        },
