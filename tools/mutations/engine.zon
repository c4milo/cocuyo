    },
    .{
        .section = "A port replaced under load",
        .id = "W3",
        .what = "a draining socket is never closed",
        .edits = .{
            .{ .file = "io/io_drive.zig", .old = "    if (drain_owed(self, server)) return;\n", .new = "    if (drain_owed(self, server) or server < 255) return;\n" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "A port replaced under load",
        .id = "W4",
        .what = "a replacement that cannot open leaves the server no socket",
        .edits = .{
            .{ .file = "io/io_udp.zig", .old = "        const fresh = try self.open_port(config, config.servers[index].endpoint.address.family);\n        self.draining[index] = self.items[index];\n        self.items[index] = fresh;", .new = "        self.draining[index] = self.items[index];\n        self.items[index] = .{};\n        const fresh = try self.open_port(config, config.servers[index].endpoint.address.family);\n        self.items[index] = fresh;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "A port replaced under load",
        .id = "W5",
        .what = "a draining socket's refused receive is never asked for again",
        .edits = .{
            .{ .file = "io/io_udp.zig", .old = "        if (draining.open and !draining.receiving) self.arm(loop, draining, index, tag) catch {};", .new = "        _ = draining;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "A port replaced under load",
        .id = "W6",
        .what = "a draining socket's ended receive is armed on the current one",
        .edits = .{
