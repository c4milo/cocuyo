            .{ .file = "io/io_request_connection.zig", .old = "        if (connection.users() != 0) continue;\n", .new = "" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "Requests replayed on the model's walks",
        .id = "RW9",
        .what = "a connection that closes keeps the datagram the loop refused",
        .edits = .{
            .{ .file = "io/io_request_connection.zig", .old = "            self.idle_since_ns = 0;\n            self.made = 0;", .new = "            self.idle_since_ns = 0;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "Requests replayed on the model's walks",
        .id = "RW10",
        .what = "an event of an opening that is gone is taken as the current one's",
        .edits = .{
            .{ .file = "io/io_request_events.zig", .old = "if (connection.state == .closed or connection.incarnation != incarnation) return null;", .new = "if (connection.state == .closed or incarnation == incarnation +% 1) return null;" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "Requests replayed on the model's walks",
        .id = "RW11",
        .what = "a datagram the loop refused is dropped",
        .edits = .{
            .{ .file = "io/io_request_connection.zig", .old = "    if (self.loop.submit(&.{operation}, &.{}) != 1) return;\n    slot.lent = true;", .new = "    if (self.loop.submit(&.{operation}, &.{}) != 1) {\n        connection.made = 0;\n        return;\n    }\n    slot.lent = true;" },
        },
        .caught_by = .short_walks,
    },
    .{
        .section = "Requests replayed on the model's walks",
        .id = "RW12",
        .what = "a GOAWAY leaves the connection up",
        .edits = .{
            .{ .file = "io/io_request_connection.zig", .old = "    assert(connection.state == .up or connection.state == .draining);\n    connection.state = .draining;\n    drained(self, server);", .new = "    assert(connection.state == .up or connection.state == .draining);\n    drained(self, server);" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "Requests replayed on the model's walks",
        .id = "RW13",
        .what = "a connection that fails while it drains fails the requests that wait",
        .edits = .{
            .{ .file = "io/io_request_connection.zig", .old = "    if (connection.state == .draining or connection.state == .closing) {", .new = "    if (false and (connection.state == .draining or connection.state == .closing)) {" },
        },
        .caught_by = .picked_walks,
    },
    .{
        .section = "Requests replayed on the model's walks",
        .id = "RW14",
        .what = "a draining connection never closes",
        .edits = .{
            .{ .file = "io/io_request_connection.zig", .old = "    if (connection.state != .draining or connection.streams != 0) return;\n    connection.state = .closing;", .new = "    if (connection.state != .draining or connection.streams != 0 or true) return;\n    connection.state = .closing;" },
