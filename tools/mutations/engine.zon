    .{
        .section = "Requests replayed on the model's walks",
        .id = "RW17",
        .what = "a failure while draining fails the waiting requests with those on streams",
        .edits = .{
            .{ .file = "io/io_request.zig", .old = "        if (request.live and request.server == server and request.stream != null) fail_one(self, index, now_ns);", .new = "        if (request.live and request.server == server) fail_one(self, index, now_ns);" },
