    .{
        .section = "A port replaced under load",
        .id = "W7",
        .what = "a query does not record the socket it left from",
        .edits = .{
            .{ .file = "io/io_send.zig", .old = "        self.sent_from[index] = .{ .server = slot, .epoch = self.sockets.epoch_of(slot) };\n", .new = "" },
        },
        .caught_by = .short_walks,
