diff --git a/conformance/dns-test/src/docker/cocuyo/Dockerfile b/conformance/dns-test/src/docker/cocuyo/Dockerfile
new file mode 100644
index 0000000..602c900
--- /dev/null
+++ b/conformance/dns-test/src/docker/cocuyo/Dockerfile
@@ -0,0 +1,11 @@
+FROM debian:bookworm-slim
+
+# Unbound iterates for cocuyo in the resolver role, with validation off. tshark lets a test
+# eavesdrop, as in the other images.
+ENV DEBIAN_FRONTEND=noninteractive
+RUN apt-get update && \
+    apt-get install -y unbound tshark && \
+    rm -rf /var/lib/apt/lists/*
+
+COPY conformance-forward cocuyo-start /usr/local/bin/
+RUN chmod +x /usr/local/bin/conformance-forward /usr/local/bin/cocuyo-start
diff --git a/conformance/dns-test/src/docker/cocuyo/cocuyo-start b/conformance/dns-test/src/docker/cocuyo/cocuyo-start
new file mode 100644
index 0000000..ae79beb
--- /dev/null
+++ b/conformance/dns-test/src/docker/cocuyo/cocuyo-start
@@ -0,0 +1,29 @@
+#!/bin/sh
+# Starts cocuyo's program from /etc/cocuyo.conf. In the resolver role, Unbound iterates from the
+# test's root hints on the loopback, with validation off, and cocuyo forwards to it and validates.
+set -eu
+. /etc/cocuyo.conf
+sed "s/^/cocuyo.conf: /" /etc/cocuyo.conf >&2
+if [ "$ROLE" = resolver ]; then
+    cat >/etc/unbound/unbound.conf <<CONF
+server:
+    verbosity: 1
+    use-syslog: no
+    interface: 127.0.0.1
+    port: 5353
+    access-control: 127.0.0.0/8 allow
+    root-hints: /etc/root.hints
+    pidfile: /tmp/unbound.pid
+    module-config: "iterator"
+    cache-max-ttl: 60
+    chroot: ""
+    username: ""
+    use-caps-for-id: no
+CONF
+    unbound -d >/tmp/unbound.stdout 2>/tmp/unbound.stderr &
+    UPSTREAM=127.0.0.1:5353
+fi
+if [ "$USE_DNSSEC" = true ]; then
+    exec conformance-forward dnssec /etc/trusted-key.key "$UPSTREAM"
+fi
+exec conformance-forward "$UPSTREAM"
