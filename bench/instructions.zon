// What each case's operations cost, written by pepegrillo's instructions tool. Write it anew
// with --rewrite, in a commit that says why the counts moved.
.{
    .counter = "cachegrind 3.22.0",
    .zig = "0.16.0",
    .target = "x86_64-linux",
    .cases = .{
        .{ .name = "query-build", .rounds = 1000, .instructions = 291000 },
        .{ .name = "query-build-tcp", .rounds = 1000, .instructions = 360000 },
        .{ .name = "parse-one", .rounds = 1000, .instructions = 1133000 },
        .{ .name = "parse-cname", .rounds = 1000, .instructions = 4231000 },
        .{ .name = "parse-sixteen", .rounds = 1000, .instructions = 12987000 },
        .{ .name = "match-stray", .rounds = 1000, .instructions = 65000 },
        .{ .name = "match-wrong", .rounds = 1000, .instructions = 266000 },
        .{ .name = "match-accept", .rounds = 1000, .instructions = 3317000 },
        .{ .name = "round-trip", .rounds = 1000, .instructions = 5302000 },
        .{ .name = "resolv-conf", .rounds = 1000, .instructions = 6641000 },
        .{ .name = "cache-hit", .rounds = 1000, .instructions = 402000 },
        .{ .name = "cache-miss", .rounds = 1000, .instructions = 294000 },
        .{ .name = "cache-put", .rounds = 1000, .instructions = 484000 },
        .{ .name = "cache-put-evict", .rounds = 1000, .instructions = 1200044 },
    },
}
