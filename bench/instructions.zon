    .counter = "cachegrind 3.26.0",
    .zig = "0.16.0",
    .target = "x86_64-linux",
    .cases = .{
        .{ .name = "query-build", .rounds = 1000, .instructions = 291000 },
        .{ .name = "query-build-tcp", .rounds = 1000, .instructions = 360000 },
        .{ .name = "parse-one", .rounds = 1000, .instructions = 1140000 },
        .{ .name = "parse-cname", .rounds = 1000, .instructions = 4247000 },
        .{ .name = "parse-sixteen", .rounds = 1000, .instructions = 12994000 },
        .{ .name = "match-stray", .rounds = 1000, .instructions = 65000 },
        .{ .name = "match-wrong", .rounds = 1000, .instructions = 316000 },
        .{ .name = "match-accept", .rounds = 1000, .instructions = 4188000 },
        .{ .name = "round-trip", .rounds = 1000, .instructions = 5499000 },
        .{ .name = "resolv-conf", .rounds = 1000, .instructions = 6684000 },
        .{ .name = "cache-hit", .rounds = 1000, .instructions = 406000 },
        .{ .name = "cache-miss", .rounds = 1000, .instructions = 294000 },
        .{ .name = "cache-put", .rounds = 1000, .instructions = 484000 },
