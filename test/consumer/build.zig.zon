.{
    .name = .consumer,
    .version = "0.0.0",
    .fingerprint = 0x705b3727a7bb8340,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .cocuyo = .{ .path = "../.." },
        // The consumer's own loop, at the pin cocuyo's comparison uses, bound into
        // `cocuyo_rotor` by build.zig.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor?ref=v0.10.0#933985882d693e4d8b876e1403618a3fc6d989ef",
            .hash = "rotor-0.10.0-YZkxRFCxJABaRNenAUK5EC84mD-ZR3zmBesT76zmXoqu",
        },
        // The consumer's own colibri, at the pin of cocuyo's `build.zig.zon`, bound into
        // `cocuyo_quic`, `chapulin_quic` and `chapulin` by build.zig. It is not lazy, as a
        // consumer that speaks DoQ or DoT needs it, so the package fetches colibri, and chapulin
        // and stdx under it.
        .colibri = .{
            .url = "git+https://github.com/c4milo/colibri?ref=v0.16.0#b604972414f4a68ab52ef613522729a53dfb05c1",
            .hash = "colibri-0.10.0-Wo-AvjeCrgQ2CoLmDuqHSEUVGxXqumzISRmI1N-u-yKe",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
        "inside",
        "embed.zig",
        "doq.zig",
        "dot.zig",
    },
}
