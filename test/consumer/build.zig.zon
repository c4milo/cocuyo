.{
    .name = .consumer,
    .version = "0.0.0",
    .fingerprint = 0x705b3727a7bb8340,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .cocuyo = .{ .path = "../.." },
        // The consumer's own loop, at the pin cocuyo's comparison uses, bound into
        // `cocuyo_rotor` by build.zig.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor?ref=v0.9.0#5a5d7d72d8ac4469a48b2a30d77380ac9dd7b90e",
            .hash = "rotor-0.9.0-YZkxRHY2FQCOGvEpDOWDofpk-UhPMwgUpaU3GyaBzhda",
        },
        // The consumer's own colibri, at the pin of cocuyo's `build.zig.zon`, bound into
        // `cocuyo_quic`, `chapulin_quic` and `chapulin` by build.zig. It is not lazy, as a
        // consumer that speaks DoQ or DoT needs it, so the package fetches colibri, and chapulin
        // and stdx under it.
        .colibri = .{
            .url = "git+https://github.com/c4milo/colibri#cd195999075e1b9f61769c5a81885c13ab13e02c",
            .hash = "colibri-0.10.0-Wo-Avjw6qARg2QugTg3xMklY5n9OtPymZhRvwRTxEbiy",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
        "inside.zig",
        "embed.zig",
        "doq.zig",
        "dot.zig",
    },
}
