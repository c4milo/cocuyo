.{
    .name = .consumer,
    .version = "0.0.0",
    .fingerprint = 0x705b3727a7bb8340,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .cocuyo = .{ .path = "../.." },
        // The consumer's own loop, at the pin cocuyo's comparison uses, bound into
        // `cocuyo_rotor` by build.zig.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor?ref=v0.4.0#8cde9a67b6fe36cee32196e054ea8c32d5b82145",
            .hash = "rotor-0.4.0-YZkxRB4NEQD0HGJ9C9Ih29POJZbRpyOh5GUSvy_wjD2q",
        },
        // The consumer's own colibri, at the pin of cocuyo's `build.zig.zon`, bound into
        // `cocuyo_quic`, `chapulin_quic` and `chapulin` by build.zig. It is not lazy, as a
        // consumer that speaks DoQ or DoT needs it, so the package fetches colibri, and chapulin
        // and stdx under it.
        .colibri = .{
            .url = "git+https://github.com/c4milo/colibri?ref=v0.9.0#bf4fe21f68c163090e53263baf0e414ae687e22c",
            .hash = "colibri-0.9.0-Wo-Avj48kQT3mwcY_qvTKYBXgrNxy__YJVgOmOY-PSYj",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "main.zig",
        "inside.zig",
        "embed.zig",
        "doq.zig",
        "dot.zig",
    },
}
