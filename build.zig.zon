.{
    .name = .cocuyo,
    .version = "0.0.0",
    .fingerprint = 0x7c9970ebe198c659,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Developer tooling only, never linked into the library (docs/design.md §17.1). Lazy, and
        // requested only when cocuyo is the root build, so a project depending on cocuyo never
        // fetches it.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#4316b905767198fb78528e7cc72fcbb2bf7663fe",
            .hash = "pepegrillo-0.0.0-axiFUAVjBwDOD6QFo7ICAVM4kCgvOpTD0uQJ7yr8UVws",
            .lazy = true,
        },
        // The event loop the second example is driven by, and the engine of `io/` under
        // `zig build bench-cares`: never of the library, and never of `zig build test`'s own
        // tests. Lazy, so a build that asks for neither does not resolve it. Pinned to the
        // release tag, whose public module is the whole of what rotor supports.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor?ref=v0.2.0#8a3a84a133a72f5c1a1bf37a52c0d39170189fb2",
            .hash = "rotor-0.2.0-YZkxRMf9DAC3cv5OTBrtCFEVLUavbX7606SW4y4qgoQd",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
    },
}
