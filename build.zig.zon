.{
    .name = .cocuyo,
    .version = "0.0.0",
    .fingerprint = 0x7c9970ebe198c659,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Developer tooling only, never linked into the library (docs/design.md §17.1). Lazy, and
        // requested only when cocuyo is the root build, so a project depending on cocuyo never
        // fetches it.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#a9de1835d214106deab9b6e5e9d8808b1ba21d0a",
            .hash = "pepegrillo-0.0.0-axiFUHyeBgAlPF-MB2DJbTzgioBT6p2BWO-KifOE8RDY",
            .lazy = true,
        },
        // The event loop the second example is driven by, and a dependency of that example alone:
        // never of the library, and never of `zig build test`'s own tests. Lazy, so a build that
        // does not ask for the example does not resolve it.
        //
        // A path rather than a URL and a hash, because rotor is a private repository. Zig's
        // fetcher speaks the git protocol anonymously, so `zig fetch` of the pushed commit fails
        // before it reads a byte (`unable to discover remote git server capabilities`), on this
        // machine as on any other. The path is the pin that works wherever rotor is checked out
        // beside this tree, which is the only place a private rotor can be read from anyway. It
        // becomes `git+https://github.com/c4milo/rotor#<commit>` with a hash the day rotor is
        // public: one `zig fetch --save=rotor`.
        .rotor = .{
            .path = "../rotor",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
    },
}
