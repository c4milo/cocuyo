.{
    .name = .cocuyo,
    .version = "0.1.0",
    .fingerprint = 0x7c9970ebe198c659,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Developer tooling only, never linked into the library (docs/design.md §17.1). Lazy, and
        // requested only when cocuyo is the root build, so a project depending on cocuyo never
        // fetches it.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#6fcb273ca37573cbcb7aa3aeaa06cc768a9a08ca",
            .hash = "pepegrillo-0.0.0-axiFUGT2CACzkYUiEAp0Dyt74j7Foq_MdBGv1QGEO2Qh",
            .lazy = true,
        },
        // The event loop the second example is driven by, and the engine of `io/` under
        // `zig build bench-cares`: never of the library, and never of `zig build test`'s own
        // tests. Lazy, so a build that asks for neither does not resolve it. Pinned to the
        // release tag, whose public module is the whole of what rotor supports.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor?ref=v0.4.0#8cde9a67b6fe36cee32196e054ea8c32d5b82145",
            .hash = "rotor-0.4.0-YZkxRB4NEQD0HGJ9C9Ih29POJZbRpyOh5GUSvy_wjD2q",
            .lazy = true,
        },
        // colibri's QUIC, which `cocuyo_quic` puts under the engine's request interface
        // (docs/design.md §24, decision 29). Never of the library in `src/`. Lazy, so a build that
        // asks for neither `cocuyo_quic` nor the engine's tests over colibri does not resolve it.
        .colibri = .{
            .url = "git+https://github.com/c4milo/colibri#8230bc2004fa86efc8285c37554958e2ff2c8efb",
            .hash = "colibri-0.0.0-Wo-AvkaYTwRrXl1o9GIavbzrWRHlUAujFBoGcm1HQFVR",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
        "io",
        "LICENSE",
    },
}
