.{
    .name = .cocuyo,
    .version = "0.7.0",
    .fingerprint = 0x7c9970ebe198c659,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // Developer tooling only, never linked into the library (docs/design.md §17.1). Lazy, and
        // requested only when cocuyo is the root build, so a project depending on cocuyo never
        // fetches it.
        .pepegrillo = .{
            .url = "git+https://github.com/c4milo/pepegrillo#9ae244b9ab55eb8c7259a656d08db85c9f8c42e8",
            .hash = "pepegrillo-0.0.0-axiFUFeJDACO8UB_GWT7OSbSKD2QOChXCg68MdfzduJq",
            .lazy = true,
        },
        // The event loop the second example is driven by, and the engine of `io/` under
        // `zig build bench-cares`: never of the library, and never of `zig build test`'s own
        // tests. Lazy, so a build that asks for neither does not resolve it. Pinned to the
        // release tag, whose public module is the whole of what rotor supports.
        .rotor = .{
            .url = "git+https://github.com/c4milo/rotor?ref=v0.9.0#5a5d7d72d8ac4469a48b2a30d77380ac9dd7b90e",
            .hash = "rotor-0.9.0-YZkxRHY2FQCOGvEpDOWDofpk-UhPMwgUpaU3GyaBzhda",
            .lazy = true,
        },
        // colibri's QUIC, which `cocuyo_quic` puts under the engine's request interface
        // (docs/design.md §24, decision 29), its TLS, which carries chapulin's objects for the DoT
        // and DoQ sessions (decision 32), and its client, whose channel `cocuyo_doh` puts under the
        // engine's DoH interface (decision 33). Never of the library in `src/`. Lazy, so a build
        // that asks for none of them does not resolve it.
        .colibri = .{
            .url = "git+https://github.com/c4milo/colibri#cd195999075e1b9f61769c5a81885c13ab13e02c",
            .hash = "colibri-0.10.0-Wo-Avjw6qARg2QugTg3xMklY5n9OtPymZhRvwRTxEbiy",
            .lazy = true,
        },
        // stdx's `platform`, the probe that the DoT, DoQ and DoH examples read under the word
        // `cpu` (docs/design.md §16 decision 48, as amended). A dependency of those examples
        // alone. No module rooted in `src/` reaches stdx, and none rooted in `io/` reaches it but
        // through colibri. `zig build graph-check` holds both. Pinned at the commit that colibri
        // cd195999 pins, so the probe's `Cpu` is the type colibri's `tls.Cpu` holds. Lazy, and
        // requested only when cocuyo is the root build, so a project depending on cocuyo never
        // fetches it.
        .stdx = .{
            .url = "git+https://github.com/c4milo/stdx#0c0ba959bda1a0e318e9171d4542beae3df262cc",
            .hash = "stdx-0.0.0-BD60tuF5NQByxf5nikkIoKXfpwr6OhHXuSP71hE5v0Ux",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "build",
        "src",
        "io",
        "LICENSE",
    },
}
